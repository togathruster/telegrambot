# Copy to .env and fill in the two required values. Everything else has a
# working default — uncomment only what you want to change.
#
#   cp .env.example .env        # Windows:  copy .env.example .env

# ── required ──────────────────────────────────────────────────────────
# my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=

# ── safety ────────────────────────────────────────────────────────────
# 1 = draft replies are logged but never sent. Leave this on until you have
# read a few of the replies it would have written. Set 0 to actually send.
SHADOW=1

# ── models ────────────────────────────────────────────────────────────
#OLLAMA_HOST=http://127.0.0.1:11434
#OLLAMA_MODEL=qwen3:14b          # writer, and the one that drafts persona.md
#CLASSIFIER_MODEL=qwen3:4b       # stage 1 labeller
#EMBED_MODEL=nomic-embed-text    # retrieval
#VERIFY_MODEL=                   # blank = use the writer model as critic
#BACKEND=ollama                  # 'canned' replies with a fixed string

# Reasoning costs latency and makes the model far likelier to say something
# rather than stay silent, which is the opposite of what this bot wants.
#OLLAMA_THINK=0
#OLLAMA_KEEP_ALIVE=30m           # avoids a multi-GB reload on every message
#OLLAMA_NUM_PREDICT=160          # reply length cap; documents get their own

# ── paths ─────────────────────────────────────────────────────────────
# Left unset, the session is found automatically — it is named after whoever
# logged in. Set this only to pin one account when several are present.
#TG_SESSION=
#DB_PATH=./secrets/state.db

# ── debugging ─────────────────────────────────────────────────────────
#LOG_LEVEL=INFO
# Dumps every prompt and raw model output to logs/prompts/. The only way to
# see what the model actually received.
#LOG_PROMPTS=0
